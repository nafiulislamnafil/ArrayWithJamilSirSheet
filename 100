#include <stdio.h>
#include<limits.h>
int main() {
    int n,maxin=0,minin=0;
    scanf("%d", &n);
    int a[n];
    int max=INT_MIN;
    int min=INT_MAX;
    for(int i = 0; i < n; i++) {
          scanf("%d", &a[i]);
    }
     for(int i = 0; i < n; i++) {
           if(a[i]>max){
            max=a[i];
            maxin=i;
           }
    }
    for(int i = 0; i < n; i++) {
           if(a[i]<min){
            min=a[i];
            minin=i;
           }
    }
    int temp=a[minin];
    a[minin]=a[maxin];
    a[maxin]=temp;
    for(int i = 0; i < n; i++) {
           printf("%d ", a[i]);
    }
return 0;
}
