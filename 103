#include <stdio.h>
int main() {
int t;
scanf("%d",&t);
for(int i = 1;i <=t; i++) {
    int n,cnt=0;
    scanf("%d", &n);
    int a[n];
    for(int i = 0; i < n; i++) {
          scanf("%d", &a[i]);
          if(a[i]>0){
                cnt++;
            }
    }
    printf("%d",cnt);
    printf("\n");
    for(int i =0; i<n; i++) {
             if(a[i]>0){
                printf("%d ",a[i]);
            }
    }
 printf("\n");
}
return 0;
}
