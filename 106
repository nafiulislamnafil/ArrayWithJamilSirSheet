#include <stdio.h>
int main() {
int t;
scanf("%d",&t);
for(int i = 1;i <=t; i++) {
    int n,flag=0;
    scanf("%d", &n);
    int a[n];
    for(int i = 0; i < n; i++) {
          scanf("%d", &a[i]);
    }
    for(int i =0; i<n-1; i++) {
            if(a[i]>=a[i+1]){
                 flag=1;
                break;
            }
    }
    if(flag==1){
        printf("NO");
    }
    else{
        printf("YES");
    }
 printf("\n");
}
return 0;
}
