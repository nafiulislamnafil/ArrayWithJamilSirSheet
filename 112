#include <stdio.h>
int main() {
    int t;
    scanf("%d", &t);

    for (int i = 1; i <= t; i++) {
        int n, x, ind = n; 
        scanf("%d", &n);
        int a[n], b[n + 1];

       
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[j]);
            b[j] = a[j];
        }

        scanf("%d", &x);

      
        for (int j = 0; j < n; j++) {
            if (b[j] > x) {
                ind = j;
                break;
            }
        }

        
        for (int j = n; j > ind; j--) {
            b[j] = b[j - 1];
        }

        
        b[ind] = x;

       
        for (int j = 0; j < n+1; j++) {
            printf("%d ", b[j]);
        }
        printf("\n");
    }

    return 0;
}
