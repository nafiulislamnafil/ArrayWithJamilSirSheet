#include <stdio.h>
int main() {
    int t;
    scanf("%d", &t);

    for (int i = 0; i < t; i++) {
        int n;
        scanf("%d", &n);

        int a[n];
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[j]);
        }

        int k;
        scanf("%d", &k);

        for (int j = 0; j < n; j++) {
            if (a[j] != k) {
                printf("%d ", a[j]);
            }
        }
        printf("\n");
    }

    return 0;
}
