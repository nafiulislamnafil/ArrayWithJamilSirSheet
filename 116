#include <stdio.h>

int main() {
    int N, M;
    scanf("%d", &N);
    int mainArr[N];
    for (int i = 0; i < N; i++) {
        scanf("%d", &mainArr[i]);
    }

    scanf("%d", &M);
    int subArr[M];
    for (int i = 0; i < M; i++) {
        scanf("%d", &subArr[i]);
    }

    int index = -1; // Default to -1 if not found

    for (int i = 0; i <= N - M; i++) { 
        int found = 1; // Assume match
        for (int j = 0; j < M; j++) {
            if (mainArr[i + j] != subArr[j]) {
                found = 0; // Mismatch found
                break;
            }
        }
        if (found) {
            index = i;
            break; // First occurrence found
        }
    }

    printf("%d\n", index);
    return 0;
}
