#include <stdio.h>
#include <limits.h>
int main(){
   int n,cnt=0;
   scanf("%d", &n);
 int a[n];
   int min= INT_MAX;
for (int i = 0; i < n; i++) {
     scanf("%d", &a[i]);
}
for (int i = 0; i < n; i++) {
    if(min>a[i]){
         min=a[i];
    }
}
for (int i = 0; i < n; i++) {
    if(min==a[i]){
         cnt++;
    }
}
if(cnt% 2 != 0)
        printf("Lucky\n");
    else
        printf("Unlucky\n");
    return 0;
}
